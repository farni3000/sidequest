# ---- AI (deepseek, OpenAI-compatible) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional fallbacks. Leave empty to let sidequest discover the best available
# model (highest reasoning) from the provider's /models endpoint.
DEEPSEEK_MODEL=
DEEPSEEK_VISION_MODEL=
DEEPSEEK_EFFORT=

# ---- Automatic route review ----
ROUTE_REVIEW_ENABLED=true
ROUTE_REVIEW_MAX_ROUNDS=3
ROUTE_REVIEW_IMAGE_WIDTH=1200
ROUTE_REVIEW_IMAGE_HEIGHT=900
ROUTE_REVIEW_TIMEOUT_S=180
ROUTE_REVIEW_MAX_FREE_WAYPOINTS=2
ROUTE_REVIEW_MAX_FREE_WAYPOINT_OFFSET_KM=25
ROUTE_REVIEW_SAVE_IMAGES=false
ROUTE_REVIEW_DATA_DIR=./data/reviews

# ---- Routing ----
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# GraphHopper is optional (Phase 2). Leave empty to disable the adapter.
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
BROUTER_URL=http://localhost:17777

# ---- Geocoding / POIs ----
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional mirror used automatically when the main instance is busy/rate-limited.
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=sidequest/0.1 (+https://github.com/anomalyco/sidequest)

# ---- App ----
DATABASE_URL=sqlite:///./data/sidequest.db
DEBUG=false
CORRIDOR_MIN_M=500
CORRIDOR_MAX_M=8000
MAX_POIS=80
MAX_HIGHLIGHTS=6
HTTP_TIMEOUT_S=30
