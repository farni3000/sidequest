# ---- AI (deepseek, OpenAI-compatible) ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Routing ----
ORS_API_KEY=
ORS_BASE_URL=https://api.openrouteservice.org
# GraphHopper is optional (Phase 2). Leave empty to disable the adapter.
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1
BROUTER_URL=http://localhost:17777

# ---- Geocoding / POIs ----
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional mirror used automatically when the main instance is busy/rate-limited.
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=sidequest/0.1 (+https://github.com/anomalyco/sidequest)

# ---- App ----
DATABASE_URL=sqlite:///./data/sidequest.db
DEBUG=false
CORRIDOR_MIN_M=500
CORRIDOR_MAX_M=8000
MAX_POIS=80
MAX_HIGHLIGHTS=6
HTTP_TIMEOUT_S=30
